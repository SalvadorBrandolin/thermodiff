# PR76 (Soave alpha, delta1 = 1 + sqrt(2)) with the yaeos cubic mixing rule CMR
# (yaeos/src/models/residual_helmholtz/cubic/mixing_rules/cubic_mixing.f90 and
#  base.f90 CMR_aijk / CMR_Dmix / CMR_Bmix; three-body parameters kijk, lijk):
#     a_ijk = (a_i a_j a_k)^(1/3) (1 - k_ijk)         D = (1/ntot) sum_ijk n_i n_j n_k a_ijk
#     b_ijk = (b_i + b_j + b_k)/3 (1 - l_ijk)         B = (1/ntot^2) sum_ijk n_i n_j n_k b_ijk
# so D is homogeneous of degree 2 and B of degree 0, as in the quadratic rule.
# ac, bi and mk (Soave m) are per-component inputs read back from the yaeos
# model; (a_i a_j a_k)^(1/3) = c_i c_j c_k with c_i = a_i^(1/3).
# Units follow yaeos: R [bar L /(mol K)], Tc [K], V [L].

model cmr
target fortran
use yaeos__constants, only: R

variables
    n   nc
    V
    T

parameters
    tc    nc
    ac    nc
    bi    nc
    mk    nc
    kijk  nc nc nc symmetric
    lijk  nc nc nc symmetric

expressions
    alpha_i = (1 + mk_i*(1 - sqrt(T/tc_i)))^2
    c_i     = (ac_i*alpha_i)^(1.0/3.0)
    ntot    = sum_m n_m
    bmix    = sum_i sum_j sum_k n_i*n_j*n_k*((bi_i + bi_j + bi_k)/3.0)*(1.0 - lijk_ijk)/ntot^2
    D       = sum_i sum_j sum_k n_i*n_j*n_k*c_i*c_j*c_k*(1.0 - kijk_ijk)/ntot
    d1      = 1.0 + sqrt(2.0)
    d2      = 1.0 - sqrt(2.0)
    f       = log((V + d1*bmix)/(V + d2*bmix))/(bmix*(d1 - d2))
    g       = R*log(1.0 - bmix/V)

function
    -ntot*g*T - D*f
